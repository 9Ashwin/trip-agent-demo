# ============================================================
# 把这份文件复制成 .env，然后填上你自己的 Key
# 一个都不填也能跑 —— 会自动进入「演示模式」，看到完整流程和模拟数据
# ============================================================

# ---------- 大模型：先选网关，再填对应 Key ----------
# 必须支持 function calling（工具调用），否则模型不会去联网搜索
#
# ⚠️ 最容易踩的坑：**不同网关的模型名不通用**
#    本项目内置了两家的默认参数，你只要填 LLM_PROVIDER + 对应 Key 就行，
#    模型名由代码自动带出（见 llm_config.py）。手写模型名很容易填错，
#    而填错不会提示「你要的是不是 xxx」，是直接 400 invalid_request_error。
#
# ── 网关 1：opencode（OpenCode Go 订阅，$10/月）──────────────
#   文档：https://opencode.ai/docs/go/
#   base_url : https://opencode.ai/zen/go/v1
#   模型名   : deepseek-v4.1-flash   ← 注意带小数点，
#              和 deepseek-v4-flash 是两个不同模型
#   额外要求 : 自定义 User-Agent + 每会话稳定的 x-opencode-session 头
#              （代码已自动处理，见 llm_config.headers()）
# OPENCODE_API_KEY=
#
# ── 网关 2：deepseek（DeepSeek 官方 API，按量计费）────────────
#   注册：https://platform.deepseek.com
#   base_url : https://api.deepseek.com/v1
#   模型名   : deepseek-flash / deepseek-v4-pro（官方只认这两个）
#   ⚠️ 官方**没有** deepseek-v4.1-flash 这个名字，别从 opencode 那边抄过来
# DEEPSEEK_API_KEY=
#
# 选哪家（默认 opencode）
LLM_PROVIDER=opencode

# 两家各自的 Key（只填实际在用的那家即可）
OPENCODE_API_KEY=
DEEPSEEK_API_KEY=

# ── 想用别的网关（智谱 / 硅基流动等）就手动指定 base_url + 模型名 ──
# 智谱 GLM-4-Flash：永久免费，中文强，国内直连（零成本首选）
#   注册：https://open.bigmodel.cn  → 「API Keys」
# LLM_PROVIDER=deepseek          # 借 deepseek 的槽位，下面三项全部手动覆盖
# LLM_API_KEY=你的智谱key
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_MODEL=glm-4-flash
#
# 硅基流动：9B 以下模型永久免费，新人送 2000 万 Token
#   注册：https://siliconflow.cn
# LLM_API_KEY=
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 手动覆盖（一般不需要，留空即用所选网关的默认值）
LLM_MODEL=
LLM_BASE_URL=
LLM_USER_AGENT=
LLM_SESSION_HEADER=

# ---------- 联网搜索 ----------
# 【默认方案】必应抓取：完全不需要 Key，国内可用，开箱即用
#   代价：属于网页抓取，对方改版可能失效、高频会被限流，仅供学习/Demo/低频使用
# 进阶可选：想要更稳、更精准，再换成下面两种（需要注册拿 Key）
#   · Tavily —— 专为 AI Agent 设计，免费 1000 次/月  https://tavily.com
#   · 博查   —— 国内可直连，按次计费  https://open.bochaai.com
#
# 可填 bing / tavily / bocha / auto（auto = 有 Key 用 Key，无 Key 用必应）
# ❌ DuckDuckGo 已从代码中移除（国内连不上 + 它根本不是搜索引擎，
#    详见 search_tool.py 顶部说明）。填了不认识的值得会静默降级成演示假数据。
SEARCH_PROVIDER=bing
TAVILY_API_KEY=

# 博查备用
BOCHA_API_KEY=

# ---------- Agent 实现（可切换） ----------
# langchain（默认）—— 用 LangChain v1 的 create_agent 编排工具调用
# native          —— 原生 OpenAI SDK 手写循环，不依赖 LangChain
# 两者对外行为一致，想对比学习时切一下即可
AGENT_IMPL=langchain

# ---------- 搜索轮数保险丝（一般不用改） ----------
# 这是防止失控的上限，不是设计上的限制。正常一次家庭出行规划
# 4~8 轮并行搜索就够，模型会自己收敛停下来。
# 目的地特别复杂（多城市/多程交通）可调大；不建议调小，会明显影响方案质量。
MAX_SEARCH_ROUNDS=15

# ---------- 瞬时失败重试次数 ----------
# 模型网关偶发会「第一轮调用 1 秒内就失败」，重试一次基本都能成。
# 只在「一次搜索都还没做」时才重试，不会重复已经花掉的搜索时间。
AGENT_RETRIES=1

# ---------- 其他 ----------
# 注意：macOS 的 5000 端口被 AirPlay 接收器占用，建议用 5050
PORT=5050

# 访问频率限制：默认 0 = 关闭
# 只有当你要把「带真实 Key 的版本」公开给不特定人群时，才需要打开（例如 20）
RATE_LIMIT_PER_HOUR=0

# SSE 心跳间隔（秒）。部署环境前面通常有反向代理，空闲太久会掐连接，
# 这里定期发一个注释行保活。设 0 可关闭。
HEARTBEAT_SECONDS=10

# 强制开启演示模式（1 = 开）：DEMO_MODE=1
DEMO_MODE=
