# ============================================================
# 把这份文件复制成 .env，然后填上你自己的 Key
# 一个都不填也能跑 —— 会自动进入「演示模式」，看到完整流程和模拟数据
# ============================================================

# ---------- 大模型（必填，才进入真实模式） ----------
# 必须支持 function calling（工具调用），否则模型不会去联网搜索
#
# 方案 A：智谱 GLM-4-Flash —— 永久免费，中文强，国内直连（零成本首选）
#   注册：https://open.bigmodel.cn  → 「API Keys」
# LLM_API_KEY=你的智谱key
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_MODEL=glm-4-flash
#
# 方案 B：DeepSeek —— 中文强，约 ¥0.7/百万 token（效果更好）
#   注册：https://platform.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 方案 C：硅基流动 —— 9B 以下模型永久免费，新人送 2000 万 Token
#   注册：https://siliconflow.cn
# LLM_API_KEY=
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---------- 联网搜索（必填其一，否则只能用演示数据） ----------
# 方案 A：Tavily，专为 AI 设计，免费 1000 次/月  https://tavily.com
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# 方案 B：博查搜索，国内可直连，按次计费  https://open.bochaai.com
# SEARCH_PROVIDER=bocha
BOCHA_API_KEY=

# ---------- 其他 ----------
# 注意：macOS 的 5000 端口被 AirPlay 接收器占用，建议用 5050
PORT=5050

# 每个 IP 每小时最多请求次数（0 = 关闭限流）
# 把真实 Key 部署到公网时，这是防额度被刷的兜底
RATE_LIMIT_PER_HOUR=20

# 强制开启演示模式（1 = 开）：DEMO_MODE=1
DEMO_MODE=
