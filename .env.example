# ============================================================
# 把这份文件复制成 .env，然后填上你自己的 Key
# 一个都不填也能跑 —— 会自动进入「演示模式」，看到完整流程和模拟数据
# ============================================================

# ---------- 大模型（必填，才进入真实模式） ----------
# 必须支持 function calling（工具调用），否则模型不会去联网搜索
#
# 方案 A：智谱 GLM-4-Flash —— 永久免费，中文强，国内直连（零成本首选）
#   注册：https://open.bigmodel.cn  → 「API Keys」
# LLM_API_KEY=你的智谱key
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_MODEL=glm-4-flash
#
# 方案 B：DeepSeek —— 中文强，约 ¥0.7/百万 token（效果更好）
#   注册：https://platform.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 方案 C：硅基流动 —— 9B 以下模型永久免费，新人送 2000 万 Token
#   注册：https://siliconflow.cn
# LLM_API_KEY=
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 方案 D：OpenCode Go 套餐（$10/月，开源编码模型）
#   文档：https://opencode.ai/docs/go/
#   注意两个坑：① 模型 ID 是 deepseek-v4.1-flash（带小数点），
#   与 deepseek-v4-flash 是不同模型；② 必须带 x-opencode-session 头
# LLM_API_KEY=
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_MODEL=deepseek-v4.1-flash
# LLM_USER_AGENT=trip-agent-demo/1.0
# LLM_SESSION_HEADER=x-opencode-session

# ---------- 部分网关的额外要求（按需填写，留空则不加） ----------
# 标识自己的客户端，不要用通用 SDK 名
LLM_USER_AGENT=
# 需要为每段会话发送稳定 session id 时，填头名称（会自动生成 uuid）
LLM_SESSION_HEADER=

# ---------- 联网搜索 ----------
# 【默认方案】必应抓取：完全不需要 Key，国内可用，开箱即用
#   代价：属于网页抓取，对方改版可能失效、高频会被限流，仅供学习/Demo/低频使用
# 进阶可选：想要更稳、更精准，再换成下面两种（需要注册拿 Key）
#   · Tavily —— 专为 AI Agent 设计，免费 1000 次/月  https://tavily.com
#   · 博查   —— 国内可直连，按次计费  https://open.bochaai.com
#
# 可填 bing / tavily / bocha / duckduckgo / auto（auto = 有 Key 用 Key，无 Key 用必应）
SEARCH_PROVIDER=bing
TAVILY_API_KEY=

# 博查备用
BOCHA_API_KEY=

# ---------- Agent 实现（可切换） ----------
# langchain（默认）—— 用 LangChain v1 的 create_agent 编排工具调用
# native          —— 原生 OpenAI SDK 手写循环，不依赖 LangChain
# 两者对外行为一致，想对比学习时切一下即可
AGENT_IMPL=langchain

# ---------- 其他 ----------
# 注意：macOS 的 5000 端口被 AirPlay 接收器占用，建议用 5050
PORT=5050

# 每个 IP 每小时最多请求次数（0 = 关闭限流）
# 把真实 Key 部署到公网时，这是防额度被刷的兜底
RATE_LIMIT_PER_HOUR=20

# 强制开启演示模式（1 = 开）：DEMO_MODE=1
DEMO_MODE=
